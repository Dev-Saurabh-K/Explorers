# Copy to .env and adjust for your environment.
# Restart `npm run dev` after changing these.

# Backend API origin (a standard HTTPS host does not need an explicit :443 port).
# For Docker Compose, pass this file with: docker compose --env-file client/.env up --build
# Backend API origin, no trailing slash and no :8000 on HTTPS.
# Vite inlines this at `npm run dev` / `npm run build` — restart after changing it.
# Example: https://backend.gitocx.duckdns.org
VITE_API_BASE_URL=http://localhost:8000

# Vite dev server: extra hosts allowed besides localhost (comma-separated)
VITE_DEV_ALLOWED_HOSTS=gitocx.duckdns.org
